# Copy to .env and fill in. Every value here is a placeholder — .env itself is
# gitignored and must never be committed.
#
# Every variable maps to a field on Settings in backend/config.py; the defaults
# shown are that field's default, so an unset variable behaves identically.

# --- Razorpay (test-mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- LLM: NVIDIA Nemotron (OpenAI-compatible API) ---
# Get a key at https://build.nvidia.com -> pick a Nemotron model -> "Get API Key"
# Check the model still exists before changing it: a retired model returns 410
# and every diagnosis degrades silently to the rule-based fallback.
#   curl -s https://integrate.api.nvidia.com/v1/models | grep nemotron
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# --- Locale ---
# Stopping rules and retry windows are merchant-local, not UTC. Any IANA zone.
MERCHANT_TIMEZONE=Asia/Kolkata

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./winback.db

# --- Retry scheduler ---
# The worker that re-enters the graph for payments whose retry window has
# arrived. Disable to run batch-only, with no second or third attempt.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
SCHEDULER_BATCH_LIMIT=50

# --- Stopping rules (defaults shown) ---
# Seed values only. Once saved from the Settings screen the database row wins,
# and editing these has no effect until that row is removed.
MAX_RETRY_ATTEMPTS=3
MIN_COOLDOWN_MINUTES=120
OUTREACH_CUTOFF_HOUR=22
HIGH_VALUE_THRESHOLD_INR=50000
