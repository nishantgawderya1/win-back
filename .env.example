# --- Razorpay (test-mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- LLM: NVIDIA Nemotron (OpenAI-compatible API) ---
# Get a key at https://build.nvidia.com -> pick a Nemotron model -> "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./winback.db

# --- Stopping rules (defaults shown; override for testing) ---
MAX_RETRY_ATTEMPTS=3
MIN_COOLDOWN_MINUTES=120
OUTREACH_CUTOFF_HOUR=22
HIGH_VALUE_THRESHOLD_INR=50000
