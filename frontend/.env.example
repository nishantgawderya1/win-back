# Frontend config. Copy to frontend/.env and fill in.
# Vite only exposes variables prefixed VITE_, and everything here is embedded
# in the built bundle — so nothing secret belongs in this file.

# --- Supabase auth ---
# Leave both blank to run in demo mode: any sign-in is accepted, the session is
# local, and the API is open. Set them (and AUTH_REQUIRED=true in the backend
# .env) to enforce real sign-in.
#
# Both values come from Supabase -> Settings -> API. The anon/publishable key is
# meant to be public: it identifies the project and grants nothing beyond what
# row-level security allows. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
