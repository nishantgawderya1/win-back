# Copy to .env and fill in. Every value here is a placeholder — .env itself is
# gitignored and must never be committed.
#
# Every variable maps to a field on Settings in backend/config.py; the defaults
# shown are that field's default, so an unset variable behaves identically.

# --- Razorpay (test-mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Required for the recovery loop: payment_link.paid callbacks are rejected
# unless this matches the secret set on the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- LLM: NVIDIA Nemotron (OpenAI-compatible API) ---
# Get a key at https://build.nvidia.com -> pick a Nemotron model -> "Get API Key"
# Check the model still exists before changing it: a retired model returns 410
# and every diagnosis degrades silently to the rule-based fallback.
#   curl -s https://integrate.api.nvidia.com/v1/models | grep nemotron
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# Nemotron reasons before answering unless told not to. Measured on the
# diagnosis prompt: 10.4s on, 3.3s off. Turn on to capture the model's full
# chain into the audit trail, at roughly 3x the latency per record.
LLM_ENABLE_THINKING=false

# --- Auth (Supabase) ---
# Off by default so a clean checkout runs with no credentials. While it is off
# every API route answers anonymous callers, and the app says so on the sign-in
# screen rather than implying a protection that is not there.
#
# Turn it on and the backend verifies each Supabase access token against the
# project's public JWKS - no shared secret is stored here. Set the matching
# VITE_SUPABASE_* values in frontend/.env too, or the UI cannot obtain a token.
AUTH_REQUIRED=false
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key

# --- Locale ---
# Stopping rules and retry windows are merchant-local, not UTC. Any IANA zone.
MERCHANT_TIMEZONE=Asia/Kolkata

# --- Batch processing ---
# Payments run concurrently; each slot holds one LLM call and a DB writer.
BATCH_CONCURRENCY=8

# --- Database ---
# SQLite by default; no setup, no network.
DATABASE_URL=sqlite+aiosqlite:///./winback.db
#
# Supabase / Postgres. Requires asyncpg (already in requirements).
# Percent-encode anything special in the password: a literal '@' is read as
# the host separator and the URL silently points somewhere else. @ is %40.
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# The db.PROJECT host resolves IPv6-only. On an IPv4-only network or host,
# use the session pooler instead, and disable prepared statements because
# pgbouncer cannot hold them across connections:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?prepared_statement_cache_size=0

# --- Retry scheduler ---
# The worker that re-enters the graph for payments whose retry window has
# arrived. Disable to run batch-only, with no second or third attempt.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
SCHEDULER_BATCH_LIMIT=50

# --- Stopping rules (defaults shown) ---
# Seed values only. Once saved from the Settings screen the database row wins,
# and editing these has no effect until that row is removed.
MAX_RETRY_ATTEMPTS=3
MIN_COOLDOWN_MINUTES=120
OUTREACH_CUTOFF_HOUR=22
HIGH_VALUE_THRESHOLD_INR=50000
